@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/wollixTargets.cmake")

# CMake maps the c_std_11 feature to /std:c11 for MSVC from 3.20; older
# CMake records the feature without a flag, so the switch is added here.
if(MSVC AND CMAKE_VERSION VERSION_LESS 3.20)
  set_property(TARGET wollix::wollix APPEND PROPERTY INTERFACE_COMPILE_OPTIONS
    "$<$<COMPILE_LANG_AND_ID:C,MSVC>:/std:c11>")
endif()

check_required_components(wollix)
